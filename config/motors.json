  "_about": "Traction motor database for the EV simulator. Torque is measured at the MOTOR SHAFT; the Drivetrain applies the gear ratio to reach the wheels.",
  "_field_notes": {
    "type": "hub_direct | mid_drive_bldc | induction | pmsm | bldc",
    "peak_power_kW": "Short-duration electrical power limit (kW).",
    "cont_power_kW": "Continuous (thermal) electrical power limit (kW).",
    "peak_torque_Nm": "Maximum motor-shaft torque in the constant-torque region (Nm).",
    "torque_end_rpm": "End of the constant-torque region / start of constant-power (base speed, rpm).",
    "field_weaken_rpm": "RPM above which field weakening makes torque fall faster than 1/rpm.",
    "fw_torque_exponent": "Torque decay exponent in the field-weakening region (T ~ (fw_rpm/rpm)^exp).",
    "max_rpm": "Mechanical RPM limit; torque is forced to zero above this.",
    "efficiency_map": "Bilinear table: values[row=rpm][col=load], load = |torque| / peak_torque_Nm.",
    "regen_max_Nm": "Maximum regenerative braking torque magnitude at low RPM (Nm).",
    "regen_taper_rpm": "RPM above which regen torque tapers linearly to zero at max_rpm.",
    "controller_max_A": "Peak motor controller phase/bus current (A).",
    "controller_max_V": "Maximum controller bus voltage (V).",
    "mass_kg": "Motor mass including integrated reduction if any (kg).",
    "pole_pairs": "Motor pole pairs (informational, for back-EMF estimates).",
    "_todo": "Values flagged with a _todo key need datasheet verification before use in engineering studies."
  },
